extends ../layouts/account.pug

block title 
  title Nhập mã OTP
  .page-account
    .form-account 
      h2.inner-title Nhập mã OTP
      p.inner-desc Vui lòng nhập mã OTP để tiếp tục
      form.inner-form
        .inner-group 
          label(
            for="OTP"
            class="inner-label"
          ) Mã OTP
          input(
            type ="text"
            name=""
            id="OTP"
            placeholder ="Ví dụ: Ví dụ: 123456"
            class="inner-control"
          )
        button.inner-button Xác thực
      .inner-more 
        span Bạn đã nhớ mật khẩu 
        a(href="#") Đăng nhập
          

      
