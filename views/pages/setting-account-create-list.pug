extends ../layouts/default.pug

block title
 title Tạo tài khoản quản trị
block main
 h1.box-title Tạo tài khoản quản trị

 //Section-8
 .section-8  
  form.inner-form(action="") 
   .inner-group 
    label(for="fullName" clas="inner-label") Họ và tên
    input(type="text" id="fullName" value="Lê Văn A") 
   .inner-group 
    label(for="email" clas="inner-label") Email
    input(type="email" id="email" value="contact@28travel.com") 
   .inner-group 
    label(for="phone" clas="inner-label") Số điện thoại
    input(type="number" id="phone" value="0123456789") 
   .inner-group 
    label(for="role" clas="inner-label") Nhóm quyền
    select(name="")
     option Quản trị viên 
     option Quản lý đơn hàng 
     option Quản lý người dùng 
   .inner-group 
    label(for="email" clas="inner-label") Chức vụ
    input(type="text" id="" value="Giám đốc") 
   .inner-group 
    label(for="status" clas="inner-label") Trạng thái
    input(type="text" id="" value="Hoạt động") 
   .inner-group 
    label(for="password" clas="inner-label") Mật khẩu
    input(type="text" id="phone" value="1234") 
   .inner-group.inner-two-col 
    label(for="avata" clas="inner-label") Ảnh đại diện
    .inner-upload-image 
     input(type="file" id="avata" accept="image/*")
   .inner-button.inner-two-col 
     button Tạo mới
  .inner-back  
   a(href="#") Quay lại danh sách
 //End Section-8
