      input(type="checkbox")
      label Xem danh mục
     .inner-checkbox-item  
      input(type="checkbox")
      label Tạo danh mục
     .inner-checkbox-item  
      input(type="checkbox")
      label Sửa danh mục
     .inner-checkbox-item  
      input(type="checkbox")
      label Xóa danh mục
   .inner-button.inner-two-col 
     button Tạo mới
  .inner-back  
   a(href="#") Quay lại danh sách
