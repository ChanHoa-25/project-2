extends ../layouts/account.pug

block title 
  title Quên mật khẩu
  .page-account
    .form-account 
      h2.inner-title Quên mật khẩu
      p.inner-desc Vui lòng nhập email để tiếp tục
      form.inner-form
        .inner-group 
          label(
            for="email"
            class="inner-label"
          ) Email 
          input(
            type ="email"
            name=""
            id="email"
            placeholder ="Ví dụ: levana@gmail.com"
            class="inner-control"
          )
        button.inner-button Gửi mã OTP
      .inner-more 
        span Bạn đã nhớ mật khẩu 
        a(href="#") Đăng nhập
          

      
