extends ../layouts/default.pug

block title
 title Thông tin cá nhân
block main
 h1.box-title Thông tin cá nhân

 //Section-8
 .section-8  
  form.inner-form(action="") 
   .inner-group 
    label(for="fullName" class="inner-label") Họ và tên
    input(type="text" id="name") 
   .inner-group 
    label(for="email" class="inner-label") Email
    input(type="email" id="email") 
   .inner-group 
    label(for="phone" class="inner-label") Số điện thoại
    input(type="number" id="phone") 
   .inner-group 
    label(for="role" class="inner-label") Chức vụ
    input(type="text" id="role" readonly) 
   .inner-group 
    label(for="role" class="inner-label") Nhóm quyền
    input(type="text" id="role" readonly) 
   .inner-group.inner-two-col 
    label(for="avata" class="inner-label") Ảnh đại diện
    .inner-upload-image 
     input(type="file" id="avata" accept="image/*")
   .inner-button.inner-two-col 
     button Cập nhật
  .inner-back  
   a(href="#") Quay lại danh sách
 
     

