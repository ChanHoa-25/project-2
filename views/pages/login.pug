extends ../layouts/account.pug

block title 
  title Đăng nhập
  .page-account
    .form-account 
      h2.inner-title Đăng nhập 
      p.inner-desc Vui lòng nhập email và mật khẩu để tiếp tục
      form.inner-form
        .inner-group 
          label(
            for="email"
            class="inner-label"
          ) Email 
          input(
            type ="email"
            name=""
            id="email"
            placeholder ="Ví dụ: levana@gmail.com"
            class="inner-control"
          )
        .inner-group 
          label(
            for="passowrd"
            class="inner-label"
          ) Mật khẩu 
          input(
            type ="password"
            name=""
            id="password"
            
            class="inner-control"
          )
        .inner-meta
          .inner-confirm 
            input(
              type="checkbox", 
              name=""
              id="remember-password",
              class="inner-check"
            )
            label(
              for="remember-password"
              class="inner-label"
              ) Nhớ mật khẩu
          a(
              href="#"
              class="inner-forgot-password"
            ) Quên mật khẩu
        button.inner-button Đăng nhập
      .inner-more 
        span Bạn chưa có tài khoản 
        a(href="#") Tạo tài khoản
          

      
