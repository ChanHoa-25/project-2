extends ../layouts/account.pug

block title 
  title Đổi mật khẩu
  .page-account
    .form-account 
      h2.inner-title Đổi mật khẩu
      p.inner-desc Vui lòng nhập mật khẩu để tiếp tục
      form.inner-form
        .inner-group 
          label(
            for="passowrd"
            class="inner-label"
          ) Mật khẩu mới
          input(
            type ="password"
            name=""
            id="password"
            class="inner-control"
          )
        .inner-group 
          label(
            for="confirm-passowrd"
            class="inner-label"
          ) Xác nhận mật khẩu 
          input(
            type ="password"
            name=""
            id="confirm-password"
            class="inner-control"
          )
        button.inner-button Thay đổi
      .inner-more 
        span Bạn đã nhớ mật khẩu?
        a(href="#") Đăng nhập
          

      
