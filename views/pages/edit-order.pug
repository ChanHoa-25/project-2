extends ../layouts/default.pug

block title
 title  Đơn hàng: OD000001
block main
 h1.box-title Đơn hàng: OD000001
 //Section-8
 .section-8  
  form.inner-form(action="") 
   .inner-group 
    label(for="name" clas="inner-label") Tên khách hàng
    input(type="text" id="name") 
   .inner-group 
    label(for="phone" clas="inner-label") Số điện thoại
    input(type="number" id="phone") 
   .inner-group.inner-two-col  
    label(for="note" clas="inner-label") Ghi chú
    textarea(id="note") 
   .inner-group 
    label(for="pay" clas="inner-label") Phương thức thanh toán
    select(id="pay") 
     option(value="") Ví Momo
     option(value="") ZaloPay 
     option(value="") VNPay 
   .inner-group 
    label(for="statusPay" clas="inner-label") Trạng thái thanh toán
    select(id="statusPay") 
     option(value="") Đã thanh toán
     option(value="") Chưa thanh toán
   .inner-group 
    label(for="oderDate" clas="inner-label") Ngày đặt
    input(type="datetime-local" id="oderDate") 
   .inner-group 
    label(for="status" clas="inner-label") Trạng thái
     select(id="statusPay") 
      option(value="") Khởi tạo
      option(value="") Hoàn thành
   .inner-group 
    label(class="inner-label") Danh sách tour
    .inner-order-list  
     .inner-order-item 
      .inner-order-image 
       img(src="assets/images/tour1.png")
      .inner-order-content  
       .inner-order-name Tour Hạ Long
       .inner-order-text Người lớn: 3 x 1.500.000đ
       .inner-order-text Trẻ em: 2 x 1.300.000đ
       .inner-order-text Em bé: 2 x 1.000.000đ
       .inner-order-text Ngày khởi hành: 20/10/2024
       .inner-order-text Khởi hành tại: Hà Nội
     .inner-order-item 
      .inner-order-image 
       img(src="assets/images/tour1.png")
      .inner-order-content  
       .inner-order-name Tour Hạ Long
       .inner-order-text Người lớn: 3 x 1.500.000đ
       .inner-order-text Trẻ em: 2 x 1.300.000đ
       .inner-order-text Em bé: 2 x 1.000.000đ
       .inner-order-text Ngày khởi hành: 20/10/2024
       .inner-order-text Khởi hành tại: Hà Nội
   .inner-group 
    label(class="inner-label") Thanh toán
    .inner-order-total  
     div Tổng tiền: 10.000.000đ
     div Giảm: 400.000đ
     div Mã giảm: TOURMUAHE2024
     div Thanh toán: <span class="inner-order-price"> 9.600.000đ </span>
    
   .inner-button.inner-two-col 
     button Cập nhật
  .inner-back  
   a(href="#") Quay lại danh sách
 //End Section-8
     

