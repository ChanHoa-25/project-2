extends ../layouts/default.pug

block title
 title Thông tin website 
block main
 h1.box-title Thông tin webstie

 //Section-8
 .section-8  
  form.inner-form#setting-infor-website-form
   .inner-group 
    label(for="websitename" class="inner-label") Tên website
    input(type="text" id="websiteName" name="websiteName" value="28.TRAVEL") 
   .inner-group 
    label(for="phone" class="inner-label") Số điện thoại
    input(type="number" id="phone" name="phone" value="0123456789") 
   .inner-group 
    label(for="email" class="inner-label") Email
    input(type="email" id="email" name="email" value="contact@28travel.com") 
   .inner-group 
    label(for="address" class="inner-label") Địa chỉ
    input(type="text" id="address" name="address" value="Số 123, đường ABC") 
   .inner-group 
    label(for="logo" class="inner-label") Logo
    div(class="inner-upload-image" accept="image/*")
     input(type="file" id="logo" name="logo"  filepond-image) 
   .inner-group 
    label(for="favicon" class="inner-label") Favicon
    div(class="inner-upload-image")
     input(type="file" id="favicon" name="favicon" accept="image/*" filepond-image) 
   .inner-button.inner-two-col 
     button Cập nhật
  .inner-back  
   a(href="#") Quay lại danh sách
 //End Section-8
