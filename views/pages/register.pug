extends ../layouts/account.pug

block title 
  title Đăng nhập
  .page-account
    .form-account 
      h2.inner-title Đăng ký
      p.inner-desc Tạo một tài khoản để tiếp tục
      form.inner-form
        .inner-group 
            label(
            for="fullName"
            class="inner-label"
            ) Họ tên 
            input(
            type ="text"
            name=""
            id="fullName"
            placeholder ="Ví dụ: Lê Văn A"
            class="inner-control"
            )
        .inner-group 
          label(
            for="email"
            class="inner-label"
          ) Email
          input(
            type ="email"
            name=""
            id="fullname"
            placeholder ="Ví dụ: levana@gmail.com"
            class="inner-control"
          )
        .inner-group 
          label(
            for="passowrd"
            class="inner-label"
          ) Mật khẩu 
          input(
            type ="password"
            name=""
            id="password"
            
            class="inner-control"
          )
        .inner-meta
          .inner-confirm 
            input(
              type="checkbox", 
              name=""
              id="agree",
              class="inner-check"
            )
            label(
              for="agree"
              class="inner-label"
              ) Tôi chấp nhận các điều khoản và điều kiện
        button.inner-button Đăng ký
      .inner-more 
        span Bạn đã có tài khoản 
        a(href="#") Đăng nhập
          

      
