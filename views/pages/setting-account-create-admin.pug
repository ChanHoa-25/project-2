extends ../layouts/default.pug

block title
 title Tạo tài khoản quản trị
block main
 h1.box-title Tạo tài khoản quản trị

 //Section-8
 .section-8  
  form.inner-form#setting-account-admin-create-form
   .inner-group 
    label(for="fullName" class="inner-label") Họ và tên
    input(type="text" id="fullName" name="fullName" value="Lê Văn A") 
   .inner-group 
    label(for="email" class="inner-label") Email
    input(type="email" id="email" name="email" value="contact@28travel.com") 
   .inner-group 
    label(for="phone" class="inner-label") Số điện thoại
    input(type="number" id="phone" name="phone" value="0123456789") 
   .inner-group 
    label(for="role" class="inner-label") Nhóm quyền
    select(name="role")
     option Quản trị viên 
     option Quản lý đơn hàng 
     option Quản lý người dùng 
   .inner-group 
    label(for="positionCompany" class="inner-label") Chức vụ
    input(type="text" id="positionCompany" name="positionCompany" value="Giám đốc") 
   .inner-group 
    label(for="status" class="inner-label") Trạng thái
    input(type="text" id="status" name="status" value="Hoạt động") 
   .inner-group 
    label(for="password" class="inner-label") Mật khẩu
    input(type="text" id="password" name="password" value="1234") 
   .inner-group.inner-two-col 
    label(for="avatar" class="inner-label") Ảnh đại diện
    .inner-upload-image 
     input(type="file" id="avatar" name="avatar" accept="image/*" filepond-image)
   .inner-button.inner-two-col 
     button Tạo mới
  .inner-back  
   a(href="#") Quay lại danh sách
 //End Section-8
